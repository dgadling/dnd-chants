{
    "firestore": {
        "indexes": "firestore.indexes.json",
        "rules": "firestore.rules"
    },
    "functions": [
        {
            "codebase": "default",
            "ignore": [
                "node_modules",
                ".git",
                "firebase-debug.log",
                "firebase-debug.*"
            ],
            "source": "functions"
        }
    ],
    "hosting": {
        "headers": [
            {
                "source": "**",
                "headers": [
                    {
                        "key": "X-Content-Type-Options",
                        "value": "nosniff"
                    }
                ]
            }
        ],
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**"
        ],
        "public": "out",
        "rewrites": [
            {
                "function": {
                    "functionId": "ttsProxy",
                    "region": "us-central1"
                },
                "source": "/api/tts"
            },
            {
                "function": {
                    "functionId": "dndbeyondProxy",
                    "region": "us-central1"
                },
                "source": "/api/dndbeyond/**"
            },
            {
                "function": {
                    "functionId": "discordAuthCallback",
                    "region": "us-central1"
                },
                "source": "/api/discord-auth/**"
            },
            {
                "source": "/api/backup",
                "function": {
                    "functionId": "backup",
                    "region": "us-central1"
                }
            },
            {
                "function": {
                    "functionId": "backup",
                    "region": "us-central1"
                },
                "source": "/api/backup/**"
            },
            {
                "destination": "/index.html",
                "source": "**"
            }
        ],
        "cleanUrls": true
    }
}
